# Copy to .env (never commit). Cloud Run reads these from Secret Manager.

# Google AI Studio key (or leave empty and use Vertex AI via ADC)
GEMINI_API_KEY=

# Gemini model ID - confirm exact ID in AI Studio
GEMINI_MODEL=gemini-flash-latest

# Gemini embedding model used for demand clustering
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# true to route Gemini through Vertex AI instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# API key for Cloud Speech-to-Text, Translation and Text-to-Speech (REST).
# Empty -> Gemini is used for transcription/translation if configured, else demo mode.
GOOGLE_API_KEY=

# true to stream requests/recommendations/decisions to BigQuery (needs GOOGLE_CLOUD_PROJECT + ADC)
USE_BIGQUERY=false

# BigQuery dataset for this project
BIGQUERY_DATASET=civic_demand_network

# Cloud Storage bucket for media/artifacts
GCS_BUCKET=

# Firebase project ID (usually = GCP project)
FIREBASE_PROJECT_ID=

# Server-side Maps key (Geocoding/Routes)
MAPS_API_KEY=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Future - leave empty
WHATSAPP_TOKEN=


# Salt for pseudonymous citizen IDs (hash of phone / chat ID). Change in any real deployment.
CITIZEN_ID_SALT=change-me

# Demo-mode runtime state file (empty = in-memory only)
# LOCAL_STATE_PATH=services/api/.data/runtime_state.json

# API
PORT=8010
CORS_ORIGINS=http://localhost:3010,http://localhost:3011
